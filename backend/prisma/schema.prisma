generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum EmailJobStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  googleId         String?          @unique
  name             String
  email            String           @unique
  avatarUrl        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  senders          Sender[]
  campaigns        Campaign[]
  emailJobs        EmailJob[]
  slackConnection  SlackConnection?
}

model Sender {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  name         String
  email        String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs    EmailJob[]

  @@index([userId])
}

model Campaign {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  name      String?
  subject   String
  body      String
  startAt   DateTime
  delayMs   Int
  hourlyLimit Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@index([userId])
}

model EmailJob {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  campaignId      String?         @db.Uuid
  senderId        String          @db.Uuid
  recipientEmail  String
  subject         String
  body            String
  scheduledAt     DateTime
  status          EmailJobStatus  @default(SCHEDULED)
  sentAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  bullJobId       String?         @unique
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sender          Sender          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([senderId, scheduledAt])
}

model SlackConnection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  accessToken String
  teamId      String?
  teamName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
